# Legacy source database. This application only performs SELECT queries.
LEGACY_DATABASE_URL=mysql+pymysql://readonly_user:change_me@db.example.com:3306/ador_tm?charset=utf8mb4

# Development only. The Vite proxy keeps browser API calls on the frontend origin.
ECHO_CORS_ORIGINS=http://localhost:9568,http://127.0.0.1:9568

# Local preview registry. It is safe to delete during early experiments.
ECHO_LOCAL_DATABASE_PATH=artifacts/local/echomerch_local.sqlite3
ECHO_COLLECTION_PARALLELISM=2

# Optional default store for local analytics when multiple stores exist.
ECHO_DEFAULT_STORE_ID=1

# Application access control. A fresh local database bootstraps admin / 123456
# as the super administrator; change the password after the first login.
ECHO_AUTH_ENABLED=true
ECHO_AUTH_SESSION_DAYS=12
ECHO_AUTH_COOKIE_SECURE=false

# Runtime browser session settings. Cookies are never stored in SQLite or logs.
# The dedicated logged-in Chrome session is the default. Use env only for CI
# or deployments that explicitly inject a cookie header and transient tokens.
ECHO_TMALL_SESSION_SOURCE=drissionpage
ECHO_TMALL_BROWSER_PORT=9222
ECHO_TMALL_COOKIE_ENV=SYCM_COOKIE

# Runtime-only values for env-mode collectors. Do not commit real values.
# DrissionPage mode captures these from the logged-in browser when possible.
SYCM_COOKIE=
SYCM_TOKEN=
RTB_CSRF_ID=
RTB_LOGIN_POINT_ID=
PZ_CSRF_ID=
CPS_TB_TOKEN=

# AI provider. Keep the real API key only in the backend runtime environment.
# Never expose it through Vite variables or commit it to source control.
ECHO_AI_BASE_URL=https://apihub.agnes-ai.com
ECHO_AI_API_PATH=/v1/chat/completions
ECHO_AI_MODEL=agnes-2.0-flash
ECHO_AI_API_KEY=
ECHO_AI_TIMEOUT_SECONDS=45
# Windows DPAPI-encrypted runtime settings written by System Management.
ECHO_AI_CREDENTIALS_PATH=artifacts/runtime/ai_credentials.bin

# Jackyun V5 inventory integration. The default endpoints match the web
# client. Tokens are refreshed through /auth/refresh and inventory is read
# from stockSkuList once per hour; secrets stay outside SQLite and API output.
ECHO_JACKYUN_TOKEN_URL=https://web.jackyun.com/auth/refresh
ECHO_JACKYUN_INVENTORY_URL=https://web.jackyun.com/jkyun/erp-stock/warehouseStock/stockSkuList
ECHO_JACKYUN_PACKAGE_URL=https://web.jackyun.com/jkyun/erp-goods/search/getskulistbycondition
ECHO_JACKYUN_PACKAGE_DETAIL_URL=https://web.jackyun.com/jkyun/erp-goods/package/getPackageId
ECHO_JACKYUN_GOODS_URL=https://web.jackyun.com/jkyun/erp-goods/search/getgoodsinfoandbaseunit
# Windows DPAPI encrypted per-user vault. This is where Refresh Token,
# Access Token and signing credentials are persisted for hourly renewal.
ECHO_JACKYUN_CREDENTIALS_PATH=artifacts/runtime/jackyun_credentials.bin
# Optional path to the existing Jackyun token_cache.json. If blank, the
# adapter can discover the sibling Arachne/JackyunV5 cache on this machine.
ECHO_JACKYUN_TOKEN_CACHE_PATH=
ECHO_JACKYUN_TOKEN=
ECHO_JACKYUN_CLIENT_ID=
ECHO_JACKYUN_CLIENT_SECRET=
ECHO_JACKYUN_USERNAME=
ECHO_JACKYUN_PASSWORD=
ECHO_JACKYUN_STORE_IDS=1
ECHO_JACKYUN_WAREHOUSE_IDS=
ECHO_JACKYUN_COOKIE=
ECHO_JACKYUN_APPKEY=jackyun_web_browser_2024
ECHO_JACKYUN_ATI=8592270430974
ECHO_JACKYUN_SIGNATURE_SECRET=
ECHO_JACKYUN_TOKEN_TTL_SECONDS=3600
ECHO_JACKYUN_INVENTORY_REFRESH_MINUTES=60

# DingTalk notification secrets. The application stores only these variable
# names in SQLite; keep real webhook URLs and signing secrets out of source.
ECHOMERCH_DINGTALK_WEBHOOK=
ECHOMERCH_DINGTALK_SECRET=
